// QuoteVault schema — GIVEN. Do not edit.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  quotes       Quote[]
}

model Quote {
  id        Int      @id @default(autoincrement())
  text      String
  author    String
  userId    Int
  owner     User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}
